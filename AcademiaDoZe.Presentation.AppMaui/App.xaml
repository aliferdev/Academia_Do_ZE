<?xml version="1.0" encoding="UTF-8" ?>

<Application
    x:Class="AcademiaDoZe.Presentation.AppMaui.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <converters:EnumDisplayConverter
                x:Key="EnumDisplayConverter" />

            <converters:DateOnlyToDateTimeConverter
                x:Key="DateOnlyToDateTimeConverter" />

            <converters:FotoToImageSourceConverter
                x:Key="FotoToImageSourceConverter" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
