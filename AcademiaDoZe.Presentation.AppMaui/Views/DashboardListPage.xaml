<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             x:DataType="vm:DashboardListViewModel"
             Title="Dashboard">

    <ScrollView>

        <VerticalStackLayout Padding="15"
                             Spacing="15">

            <!-- Logo -->
            <Image Source="academiadoze.png"
                   HeightRequest="120"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <!-- Título -->
            <Label Text="Academia do Zé"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Label Text="Dashboard"
                   FontSize="18"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <!-- Cards -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">

                <!-- Card Logradouros -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,10"
                        Padding="15"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">

                        <Label FontFamily="MaterialIcons"
                               Text="&#xe7f1;"
                               FontSize="32"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding TotalLogradouros}"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Logradouros"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- Card Alunos -->
                <Border Grid.Row="0"
                        Grid.Column="1"
                        Margin="15,10"
                        Padding="15"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">

                        <Label FontFamily="MaterialIcons"
                               Text="&#xe80c;"
                               FontSize="32"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding TotalAlunos}"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Alunos"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- Card Colaboradores -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Margin="15,10"
                        Padding="15"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">

                        <Label FontFamily="MaterialIcons"
                               Text="&#xea67;"
                               FontSize="32"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding TotalColaboradores}"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Colaboradores"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- Card Matrículas -->
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Margin="15,10"
                        Padding="15"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">

                        <Label FontFamily="MaterialIcons"
                               Text="&#xefec;"
                               FontSize="32"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding TotalMatriculas}"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Matrículas"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>