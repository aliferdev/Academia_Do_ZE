<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:DataType="vm:ColaboradorViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />
            <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTimeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label
                Text="{Binding Title}"
                FontSize="26"
                FontAttributes="Bold" />

            <Label Text="Dados pessoais" FontSize="20" FontAttributes="Bold" />

            <Label Text="Nome completo" />
            <Entry
                Placeholder="Digite o nome completo"
                Text="{Binding Colaborador.Nome}"
                MaxLength="150" />

            <Label Text="CPF" />
            <Entry
                Placeholder="Digite o CPF"
                Text="{Binding Colaborador.Cpf}"
                Keyboard="Numeric"
                MaxLength="14" />

            <Label Text="Data de nascimento" />
            <DatePicker
                Date="{Binding Colaborador.DataNascimento, Converter={StaticResource DateOnlyToDateTimeConverter}}" />

            <Label Text="Telefone" />
            <Entry
                Placeholder="Digite o telefone"
                Text="{Binding Colaborador.Telefone}"
                Keyboard="Telephone"
                MaxLength="20" />

            <Label Text="E-mail" />
            <Entry
                Placeholder="Digite o e-mail (opcional)"
                Text="{Binding Colaborador.Email}"
                Keyboard="Email"
                MaxLength="150" />

            <Label Text="Senha" />
            <Entry
                Placeholder="Obrigatória no cadastro; opcional na edição"
                Text="{Binding Colaborador.Senha}"
                IsPassword="True" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

            <Label Text="Endereço" FontSize="20" FontAttributes="Bold" />

            <Label Text="Logradouro" />
            <Picker
                Title="Selecione um logradouro"
                ItemsSource="{Binding Logradouros}"
                ItemDisplayBinding="{Binding Nome}"
                SelectedItem="{Binding LogradouroSelecionado}" />

            <Label Text="Número" />
            <Entry
                Placeholder="Número do endereço"
                Text="{Binding Colaborador.Numero}"
                Keyboard="Numeric"
                MaxLength="20" />

            <Label Text="Complemento" />
            <Entry
                Placeholder="Apartamento, sala etc. (opcional)"
                Text="{Binding Colaborador.Complemento}"
                MaxLength="100" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

            <Label Text="Dados profissionais" FontSize="20" FontAttributes="Bold" />

            <Label Text="Data de admissão" />
            <DatePicker
                Date="{Binding Colaborador.DataAdmissao, Converter={StaticResource DateOnlyToDateTimeConverter}}" />

            <Label Text="Tipo de colaborador" />
            <Picker
                Title="Selecione o tipo"
                ItemsSource="{Binding Tipos}"
                SelectedItem="{Binding Colaborador.Tipo}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />

            <Label Text="Vínculo empregatício" />
            <Picker
                Title="Selecione o vínculo"
                ItemsSource="{Binding Vinculos}"
                SelectedItem="{Binding Colaborador.Vinculo}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Button
                Text="Salvar"
                Command="{Binding SaveColaboradorCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <Button
                Text="Cancelar"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

