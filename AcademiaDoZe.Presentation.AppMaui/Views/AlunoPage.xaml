<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DateOnlyToDateTimeConverter
                x:Key="DateOnlyToDateTimeConverter" />
            <converters:FotoToImageSourceConverter
                x:Key="FotoToImageSourceConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label
                Text="{Binding Title}"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="Dados pessoais"
                FontSize="20"
                FontAttributes="Bold" />

            <Label Text="Nome completo" />
            <Entry
                Placeholder="Digite o nome completo"
                Text="{Binding Aluno.Nome}"
                MaxLength="150" />

            <Label Text="CPF" />
            <Entry
                Placeholder="Digite o CPF"
                Text="{Binding Aluno.Cpf}"
                Keyboard="Numeric"
                MaxLength="14" />

            <Button
                Text="Buscar CPF"
                Command="{Binding BuscarCpfCommand}" />

            <Label Text="Data de nascimento" />
            <DatePicker
                Date="{Binding Aluno.DataNascimento,
                    Converter={StaticResource DateOnlyToDateTimeConverter}}" />

            <Label Text="Telefone" />
            <Entry
                Placeholder="Digite o telefone"
                Text="{Binding Aluno.Telefone}"
                Keyboard="Telephone"
                MaxLength="20" />

            <Label Text="E-mail" />
            <Entry
                Placeholder="Digite o e-mail (opcional)"
                Text="{Binding Aluno.Email}"
                Keyboard="Email"
                MaxLength="150" />

            <Label Text="Senha" />
            <Entry
                Placeholder="Obrigatória no cadastro"
                Text="{Binding Aluno.Senha}"
                IsPassword="True" />

            <Label
                Text="Foto do aluno"
                FontAttributes="Bold" />

            <Image
                Source="{Binding Aluno.Foto,
                    Converter={StaticResource FotoToImageSourceConverter}}"
                HeightRequest="140"
                WidthRequest="140"
                Aspect="AspectFill"
                HorizontalOptions="Center" />

            <Button
                Text="Selecionar imagem"
                Command="{Binding SelecionarFotoCommand}" />

            <BoxView
                HeightRequest="1"
                Color="LightGray"
                Margin="0,8" />

            <Label
                Text="Endereço"
                FontSize="20"
                FontAttributes="Bold" />

            <Label Text="CEP" />
            <Entry
                Placeholder="Digite o CEP cadastrado"
                Text="{Binding CepBusca}"
                Keyboard="Numeric"
                MaxLength="9"
                ReturnCommand="{Binding BuscarCepCommand}" />

            <Button
                Text="Buscar CEP"
                Command="{Binding BuscarCepCommand}" />

            <Label Text="Logradouro" />
            <Picker
                Title="Selecione um logradouro"
                ItemsSource="{Binding Logradouros}"
                ItemDisplayBinding="{Binding Nome}"
                SelectedItem="{Binding LogradouroSelecionado}" />

            <Label Text="Número" />
            <Entry
                Placeholder="Número do endereço"
                Text="{Binding Aluno.Numero}"
                Keyboard="Numeric"
                MaxLength="20" />

            <Label Text="Complemento" />
            <Entry
                Placeholder="Apartamento, sala etc. (opcional)"
                Text="{Binding Aluno.Complemento}"
                MaxLength="100" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Button
                Text="Salvar"
                Command="{Binding SaveAlunoCommand}" />

            <Button
                Text="Cancelar"
                Command="{Binding CancelCommand}"
                BackgroundColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>